# Шаблон локального окружения. run.sh создаст .env отсюда, если файла нет,
# и заменит плейсхолдеры секретов на случайные значения.

# Уведомления по email. Без реальных учётных данных оставьте выключенными.
export SMTP_ENABLED=false
export SMTP_HOST=smtp.example.com
export SMTP_PORT=465
export SMTP_SECURITY=tls
export SMTP_USERNAME=
export SMTP_PASSWORD=
export SMTP_FROM_EMAIL=no-reply@example.com
export SMTP_SENDER_NAME='IoT Monitor'
export SMTP_TIMEOUT_SECONDS=20
export PLATFORM_URL=http://localhost:5173

# Токен Telegram-бота (необязательно).
export TELEGRAM_BOT_TOKEN=

# Секреты для iot_core: генерируются автоматически при первом запуске.
export PASSWORD_PEPPER=replace-with-random-hex
export JWT_SECRET=replace-with-random-hex-at-least-32-characters
