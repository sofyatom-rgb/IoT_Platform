              "path": [
                "rules",
                "{{rule_id}}"
              ]
            },
            "description": "Получить одно правило по rule_id."
          },
          "response": []
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"operator\": \">\",\n  \"value\": 35\n}",
