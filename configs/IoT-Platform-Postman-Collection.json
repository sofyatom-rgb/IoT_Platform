        {
          "name": "Create Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"operator\": \">\",\n  \"value\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/rules",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules"
              ]
            },
            "description": "Создаёт правило температуры. Операторы: >, <, =, !=. Успешный ответ содержит rule_id; сохраните его в переменную rule_id."
          },
          "response": []
        },
        {
          "name": "List Rules by Device",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/rules?device_id={{device_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules"
              ],
              "query": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}"
                }
              ]
            },
            "description": "Возвращает все правила устройства."
          },
          "response": []
        },
