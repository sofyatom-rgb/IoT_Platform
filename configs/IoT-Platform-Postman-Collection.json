        {
          "name": "Create Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_id\": 1,\n  \"name\": \"Living room sensor\",\n  \"type\": \"temperature\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{core_url}}/devices",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices"
              ]
            },
            "description": "Создать устройство. Успешный ответ: 201 Created; Location содержит URI созданного устройства."
          },
          "response": []
        },
        {
          "name": "Get Device",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{core_url}}/devices/1",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Device",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_id\": 1,\n  \"name\": \"Kitchen sensor\",\n  \"type\": \"temperature\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{core_url}}/devices/1",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Device",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{core_url}}/devices/1",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Save Telemetry - Core",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperature\": 31.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{core_url}}/devices/{{device_id}}/telemetry",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "{{device_id}}",
                "telemetry"
              ]
            },
            "description": "POST создаёт новое показание для устройства из URI. В теле передаётся только temperature."
          },
          "response": [],
          "description": "Добавить показание в коллекцию телеметрии устройства. Идентификатор берётся из URI."
        },
        {
          "name": "Get Device Telemetry - Core",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{core_url}}/devices/1/telemetry",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "1",
                "telemetry"
              ]
            },
            "description": "Получить последние показания устройства. ID указан в URI, тело запроса отсутствует."
          },
          "response": [],
          "description": "Получить последние показания устройства. Идентификатор находится в URI; GET не использует тело запроса."
        },
        {
          "name": "Delete Telemetry - Core",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{core_url}}/devices/1/telemetry",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "devices",
                "1",
                "telemetry"
              ]
            },
            "description": "Удалить все показания устройства. ID указан в URI, тело запроса отсутствует; успех — 204 No Content."
          },
          "response": [],
          "description": "Удалить историю показаний устройства. Идентификатор находится в URI; DELETE не использует тело запроса."
        }
      ]
    },
    {
      "name": "Adapter",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{adapter_url}}/health",
              "host": [
                "{{adapter_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка доступности HTTP Adapter."
          },
          "response": []
        },
        {
          "name": "Create Telemetry via Adapter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperature\": 23.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{adapter_url}}/devices/{{device_id}}/telemetry",
              "host": [
                "{{adapter_url}}"
              ],
              "path": [
                "devices",
                "{{device_id}}",
                "telemetry"
              ]
            },
            "description": "POST создаёт новое показание для устройства из URI. В теле — temperature либо зашифрованный конверт с этим полем."
          },
          "response": [],
          "description": "Добавить показание через Adapter. Идентификатор берётся из URI. Работает напрямую только если codec_enabled=false; иначе используй codec_cli для шифрования JSON с temperature."
        },
        {
          "name": "Get Device Telemetry - Adapter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{adapter_url}}/devices/1/telemetry",
              "host": [
                "{{adapter_url}}"
              ],
              "path": [
                "devices",
                "1",
                "telemetry"
              ]
            },
            "description": "Получить историю показаний устройства через Core. ID указан в URI."
          },
          "response": []
        },
        {
          "name": "Delete via Adapter",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{adapter_url}}/devices/1/telemetry",
              "host": [
                "{{adapter_url}}"
              ],
              "path": [
                "devices",
                "1",
                "telemetry"
              ]
            },
            "description": "Удалить историю показаний устройства через Core. Успех — 204 No Content."
          },
          "response": [],
          "description": "Удалить историю показаний устройства через Core. DELETE не использует тело запроса."
        }
      ]
    },
    {
      "name": "Notification",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notify_url}}/health",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка доступности Notification Service."
          },
          "response": []
        },
        {
          "name": "Create Temperature Alert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"chat_id\": \"123456789\",\n  \"email\": \"owner@example.com\",\n  \"device_name\": \"Датчик в гостиной\",\n  \"temperature\": 31.5,\n  \"threshold\": 30.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{notify_url}}/notifications/temperature-alerts",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "notifications",
                "temperature-alerts"
              ]
            },
            "description": "Отправляет уведомление о превышении порога температуры. device_id связывает алерт с устройством; обязателен хотя бы один контакт: chat_id или email."
          },
          "response": []
        },
        {
          "name": "Clear Temperature Alert",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{notify_url}}/notifications/temperature-alerts/{{device_id}}",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "notifications",
                "temperature-alerts",
                "{{device_id}}"
              ]
            },
            "description": "Удалить активное температурное уведомление указанного устройства. Успешный ответ: 204 No Content."
          },
          "response": []
        },
        {
          "name": "Send Email Alert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"event_type\": \"temperature_threshold_exceeded\",\n  \"sensor_name\": \"Living room sensor\",\n  \"reading_value\": \"31.5\",\n  \"unit\": \"°C\",\n  \"threshold\": \"30\",\n  \"severity\": \"WARNING\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{notify_url}}/notifications/emails",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "notifications",
                "emails"
              ]
            },
            "description": "Отправить email-уведомление. Обязательны email, event_type, sensor_name и reading_value."
          },
          "response": []
        },
        {
          "name": "Send Test Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{notify_url}}/notifications/test-emails",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "notifications",
                "test-emails"
              ]
            },
            "description": "Отправить тестовое письмо на указанный email."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rule Engine",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/health",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Проверка доступности Rule Engine."
          },
          "response": []
        },
        {
          "name": "Create Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"operator\": \">\",\n  \"value\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/rules",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules"
              ]
            },
            "description": "Создаёт правило температуры. Операторы: >, <, =, !=. Успешный ответ содержит rule_id; сохраните его в переменную rule_id."
          },
          "response": []
        },
        {
          "name": "List Rules by Device",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/rules?device_id={{device_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules"
              ],
              "query": [
                {
                  "key": "device_id",
                  "value": "{{device_id}}"
                }
              ]
            },
            "description": "Возвращает все правила устройства."
          },
          "response": []
        },
        {
          "name": "Get Rule",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/rules/{{rule_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules",
                "{{rule_id}}"
              ]
            },
            "description": "Получить одно правило по rule_id."
          },
          "response": []
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"operator\": \">\",\n  \"value\": 35\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/rules/{{rule_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules",
                "{{rule_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Rule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/rules/{{rule_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules",
                "{{rule_id}}"
              ]
            },
            "description": "Удалить правило по rule_id."
          },
          "response": []
        },
        {
          "name": "Submit Telemetry Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"temperature\": 31.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/telemetry-events",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "telemetry-events"
              ]
            },
            "description": "Проверяет температуру по правилам устройства и при срабатывании отправляет уведомление. Не сохраняет показание и не запускается автоматически при отправке через Core или Adapter."
          },
          "response": []
        }
      ]
    }
  ]
}
