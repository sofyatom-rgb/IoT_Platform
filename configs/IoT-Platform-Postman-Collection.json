{
  "info": {
    "_postman_id": "iot-platform-collection-001",
    "name": "IoT Platform",
    "description": "REST-style API for IoT Core (8080), HTTP Adapter (8081), Notification Service (8082) and Rule Engine (8083). Telemetry operations use /devices/{id}/telemetry. Adapter requires codec_enabled=false or a payload encoded with codec_cli.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "core_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "adapter_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "notify_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "rule_engine_url",
      "value": "http://localhost:8083"
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "device_id",
      "value": "1"
    },
    {
      "key": "rule_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Core",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
