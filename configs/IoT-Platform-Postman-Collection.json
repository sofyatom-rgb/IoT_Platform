    {
      "name": "Notification",
      "item": [
        {
          "name": "Send Temperature Alert",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": \"123456789\",\n  \"email\": \"owner@example.com\",\n  \"device_name\": \"Датчик в гостиной\",\n  \"temperature\": 31.5,\n  \"threshold\": 30.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{notify_url}}/notifications/temperature",
              "host": [
                "{{notify_url}}"
              ],
              "path": [
                "notifications",
                "temperature"
              ]
            },
            "description": "Отправляет уведомление о превышении порога температуры в Telegram и/или по email. Обязательны device_name, temperature, threshold и хотя бы один контакт: chat_id или email. Ответ содержит статусы каналов: telegram/email = sent|skipped|failed:..."
          },
          "response": []
        }
      ]
    },
    {
