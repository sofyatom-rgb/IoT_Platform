            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@example.com\",\n  \"password\": \"secret\",\n  \"name\": \"Alex Updated\",\n  \"telegram_chat_id\": \"123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{core_url}}/users/1",
              "host": [
                "{{core_url}}"
              ],
              "path": [
                "users",
                "1"
              ]
            }
          },
          "response": []
