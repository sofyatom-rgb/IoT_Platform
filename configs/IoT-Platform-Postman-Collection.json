                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/rules/{{rule_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules",
                "{{rule_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Rule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{rule_engine_url}}/rules/{{rule_id}}",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "rules",
                "{{rule_id}}"
              ]
            },
            "description": "Удалить правило по rule_id."
          },
          "response": []
        },
        {
          "name": "Check Telemetry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": {{device_id}},\n  \"temperature\": 31.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{rule_engine_url}}/telemetry",
              "host": [
                "{{rule_engine_url}}"
              ],
              "path": [
                "telemetry"
              ]
