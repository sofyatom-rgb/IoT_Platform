{
  "info": {
    "_postman_id": "iot-platform-collection-001",
    "name": "IoT Platform REST",
    "description": "REST-only API без legacy-алиасов. Core (/8080) требует JWT для пользователей, устройств и телеметрии. Adapter (/8081) принимает зашифрованный конверт {checksum,ciphertext} на POST /devices/{id}/telemetry и шифрует ответ. Notification Service — /8082, Rule Engine — /8083. Сначала выполни Auth -> Login, затем используй переменные token, user_id, device_id. Пример конверта для Adapter можно получить командой: ./build/bin/codec_cli encode <codec_key> '{\"temperature\":23.5}'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "core_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "adapter_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "notify_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "rule_engine_url",
      "value": "http://localhost:8083"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "device_id",
      "value": "1"
    },
    {
      "key": "rule_id",
      "value": "1"
    },
    {
      "key": "from",
      "value": "2026-01-01T00:00:00.000Z"
    },
    {
      "key": "to",
      "value": "2027-01-01T00:00:00.000Z"
    },
    {
      "key": "after_id",
      "value": "0"
    },
    {
      "key": "all_time",
      "value": "true"
    },
    {
      "key": "telemetry_envelope",
      "value": "{\"checksum\":\"...\",\"ciphertext\":\"...\"}"
    }
  ],
  "item": [
