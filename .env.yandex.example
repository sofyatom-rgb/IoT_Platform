# Copy to .env locally, fill SMTP_USERNAME and SMTP_PASSWORD, then source it
# before starting notification_service. This file contains no real credentials.
export SMTP_ENABLED=true
export SMTP_HOST=smtp.yandex.ru
export SMTP_PORT=465
export SMTP_SECURITY=tls

# Full Yandex mailbox address. For Yandex 360 this must be the full address.
export SMTP_USERNAME=alerts@example.yandex.ru
# Generate a separate Yandex Mail application password; never use account password.
export SMTP_PASSWORD=replace-with-yandex-app-password
export SMTP_FROM_EMAIL=alerts@example.yandex.ru
export SMTP_SENDER_NAME='IoT Monitor'
export SMTP_TIMEOUT_SECONDS=20
# Optional: makes the button in alert email point back to the web UI.
export PLATFORM_URL=http://localhost:5173

# Telegram channel can be used together with Yandex SMTP.
# Paste the BotFather token only in your local .env, never in this template.
export TELEGRAM_BOT_TOKEN=
